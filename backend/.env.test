# Test Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=test
FRONTEND_URL=http://localhost:3000

# Test Database Configuration
DATABASE_URL=postgresql://localhost:5432/ai_story_app_test
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=2000

# Test Redis Configuration
REDIS_URL=redis://localhost:6379/1

# JWT Configuration (test keys)
JWT_SECRET=test-jwt-secret-key
JWT_EXPIRES_IN=1h

# Logging Configuration
LOG_LEVEL=error

# Test AI Provider Keys (mocked)
OPENAI_API_KEY=test-openai-key
ANTHROPIC_API_KEY=test-anthropic-key
GOOGLE_AI_API_KEY=test-google-key

# Rate Limiting (relaxed for tests)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Configuration
UPLOAD_DIR=./test-uploads
MAX_FILE_SIZE=1048576

# Session Configuration
SESSION_SECRET=test-session-secret
SESSION_MAX_AGE=3600000

# Encryption Keys (test key)
ENCRYPTION_KEY=test-encryption-key-32-characters

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EXPORT=true
ENABLE_COLLABORATION=false

# Performance Settings (faster for tests)
GENERATION_TIMEOUT_MS=10000
EXPORT_TIMEOUT_MS=5000
MAX_CONCURRENT_GENERATIONS=2