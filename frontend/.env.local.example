# Local Development Environment Variables
# Rename this file to .env.local for local development

# API Configuration (local development)
REACT_APP_API_URL=http://localhost:3001/api/v1
REACT_APP_WS_URL=http://localhost:3001

# Development Features
REACT_APP_DEBUG=true
GENERATE_SOURCEMAP=true

# Local Feature Flags
REACT_APP_ENABLE_REGISTRATION=true
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_COLLABORATION=false

# Development Settings
REACT_APP_AUTOSAVE_INTERVAL=10000
REACT_APP_PROGRESS_POLL_INTERVAL=1000

# Local Performance Settings
REACT_APP_MAX_STORY_LENGTH=200000

# Cache Settings (disabled for development)
REACT_APP_CACHE_STORIES=false
REACT_APP_CACHE_TEMPLATES=false