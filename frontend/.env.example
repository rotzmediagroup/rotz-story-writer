# AI Story Generation App - Frontend Environment Configuration

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api/v1
REACT_APP_WS_URL=http://localhost:3001

# App Configuration
REACT_APP_VERSION=1.0.0
REACT_APP_NAME=StoryForge AI

# Feature Flags
REACT_APP_ENABLE_REGISTRATION=true
REACT_APP_ENABLE_EXPORT=true
REACT_APP_ENABLE_COLLABORATION=false
REACT_APP_ENABLE_ANALYTICS=false

# External Services
# REACT_APP_ANALYTICS_ID=your-google-analytics-id
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Development Settings
REACT_APP_DEBUG=false
GENERATE_SOURCEMAP=true

# Performance Settings
REACT_APP_MAX_STORY_LENGTH=200000
REACT_APP_AUTOSAVE_INTERVAL=30000
REACT_APP_PROGRESS_POLL_INTERVAL=2000

# UI Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_ITEMS_PER_PAGE=20
REACT_APP_MAX_UPLOAD_SIZE=10485760

# Cache Settings
REACT_APP_CACHE_STORIES=true
REACT_APP_CACHE_TEMPLATES=true
REACT_APP_CACHE_TTL=300000